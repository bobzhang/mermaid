name = "bobzhang/beautiful_mermaid"

version = "0.1.5"

import {
  "moonbitlang/async@0.21.2",
}

readme = "README.mbt.md"

repository = "https://github.com/bobzhang/mermaid"

license = "MIT"

keywords = [ "mermaid", "diagram", "svg", "ascii", "renderer", "moonbit" ]

description = "MoonBit port of beautiful-mermaid: render Mermaid diagrams to SVG and ASCII/Unicode text."

warnings = "+missing_doc+unnecessary_annotation"

preferred_target = "native"
